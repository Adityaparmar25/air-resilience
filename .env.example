# Clean Air & Climate Resilience - Environment Configuration
# DO NOT COMMIT REAL CREDENTIALS TO GIT. Use this file as a template.

# Google Cloud Platform
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json  # Dev only; Cloud Run uses ADC
STORAGE_BUCKET=your-air-resilience-citizen-images
FIREBASE_PROJECT_ID=your-firebase-project-id

# Google AI / Vertex AI
VERTEX_AI_ENABLED=true
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your-gemini-api-key  # Dev direct fallback only; not required when VERTEX_AI_ENABLED=true

# Operational Database (Firestore)
FIRESTORE_DATABASE=(default)

# Analytical Warehouse (BigQuery)
BIGQUERY_DATASET=air_resilience
FORECAST_PROVIDER=BIGQUERY_TIMESFM

# Application Environment & Server Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
